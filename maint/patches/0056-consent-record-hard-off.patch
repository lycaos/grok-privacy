From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lycaos <caraboune@gmail.com>
Date: Sun, 16 Aug 2026 18:41:29 +0200
Subject: [PATCH] consent-record-hard-off: consent acknowledgments stay local
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream 1.0.4 introduced a consent flow whose acceptance emits an ACP
"x.ai/consent/record" request. Today it dies on method_not_found (no
server handler yet), so the wire behavior is unchanged — but a future
upstream release would start reporting acceptances silently, outside
every existing gate.

Two gates, mirroring the session-writeback pattern:
- dispatch_accept_consent only emits Effect::RecordConsentUpstream
  outside privacy builds; the local PersistConsentAnswer is untouched,
  so the notice never re-arms and the consent screen works as before.
- the effect handler is the send-site chokepoint: even a caller that
  emits the effect directly cannot reach acp_send in a privacy build.

Gork-Patch-Id: consent-record-hard-off
Gork-Invariant: consent-ack-stays-local
Gork-Risk: critical
---
 .../src/app/dispatch/session/lifecycle.rs             |  7 ++++++-
 .../src/app/dispatch/tests/session/lifecycle.rs       |  4 +++-
 crates/codegen/xai-grok-pager/src/app/effects/mod.rs  | 11 +++++++++++
 3 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs b/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs
index 1a4ca23769b414ab4fcd8ba5276dd0269e0f2153..e5411b95cea7f6ac71232b2a2670f45ea76e8e69 100644
--- a/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs
+++ b/crates/codegen/xai-grok-pager/src/app/dispatch/session/lifecycle.rs
@@ -669,7 +669,12 @@ pub(in crate::app::dispatch) fn dispatch_accept_consent(app: &mut AppView) -> Ve
             acked: false,
         });
     }
-    effects.push(Effect::RecordConsentUpstream { notice_id, version });
+    // Grok Privacy: the acceptance is recorded in the local config only —
+    // nothing about it is reported to xAI. The send site keeps a second gate
+    // (see `Effect::RecordConsentUpstream` in `app/effects/mod.rs`).
+    if !xai_grok_version::PRIVACY_BUILD {
+        effects.push(Effect::RecordConsentUpstream { notice_id, version });
+    }
     effects.extend(finish_consent(app));
     effects
 }
diff --git a/crates/codegen/xai-grok-pager/src/app/dispatch/tests/session/lifecycle.rs b/crates/codegen/xai-grok-pager/src/app/dispatch/tests/session/lifecycle.rs
index fd76a29fd768dc3109a310ba403dbc73d5a5c6ee..471921bc24efbd439d54876764e92f02341c2233 100644
--- a/crates/codegen/xai-grok-pager/src/app/dispatch/tests/session/lifecycle.rs
+++ b/crates/codegen/xai-grok-pager/src/app/dispatch/tests/session/lifecycle.rs
@@ -1235,10 +1235,12 @@ fn accepting_records_the_answer_and_replays_deferred_startup() {
                 && *version == 3
                 && !acked
     )));
+    // Grok Privacy: the acceptance stays local — nothing is reported to xAI.
     assert!(
-        effects
+        !effects
             .iter()
             .any(|e| matches!(e, Effect::RecordConsentUpstream { .. })),
+        "accepting a consent notice must not emit an upstream record in a privacy build",
     );
     assert!(
         effects
diff --git a/crates/codegen/xai-grok-pager/src/app/effects/mod.rs b/crates/codegen/xai-grok-pager/src/app/effects/mod.rs
index cdd5c878a2e476c5f768e8658bb7de065d58f2fc..91e9d5dc08299a5679b30a8853822746150f45dc 100644
--- a/crates/codegen/xai-grok-pager/src/app/effects/mod.rs
+++ b/crates/codegen/xai-grok-pager/src/app/effects/mod.rs
@@ -2042,6 +2042,17 @@ pub(crate) fn execute(
                 });
         }
         Effect::RecordConsentUpstream { notice_id, version } => {
+            // Grok Privacy chokepoint: consent acknowledgments never leave this
+            // machine, even if a future caller emits the effect without going
+            // through `dispatch_accept_consent`.
+            if xai_grok_version::PRIVACY_BUILD {
+                tracing::info!(
+                    notice = %notice_id,
+                    version,
+                    "privacy: consent acknowledgment stays local; not reported upstream"
+                );
+                return (false, meta);
+            }
             let tx = acp_tx.clone();
             tasks
                 .spawn(async move {

