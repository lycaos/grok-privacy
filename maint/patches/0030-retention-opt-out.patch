     /// disabled — nothing may leave the machine while the privacy state is
     /// unknown.
+    ///
+    /// Grok Privacy: always `false`.
     pub(crate) fn allows_data_collection(&self) -> bool {
+        if xai_grok_version::research_data_collection_forbidden() {
+            return false;
+        }
